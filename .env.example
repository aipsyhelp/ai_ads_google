# =============================================================================
# Google Ads AI Automation — environment template
# Copy to .env and fill with YOUR values. Never commit .env.
# Run:  python scripts/init_project.py
# =============================================================================

# --- Google Ads API ---
# Developer token from Google Ads API Center (test token OK for read-only).
GOOGLE_ADS_DEVELOPER_TOKEN=

# LOGIN = MCC / manager account ID (digits only, no dashes).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# CUSTOMER = client account that owns campaigns (digits only, no dashes).
GOOGLE_ADS_CUSTOMER_ID=

# Service account (recommended) OR OAuth user credentials.
GOOGLE_ADS_USE_SERVICE_ACCOUNT=true
GOOGLE_ADS_SERVICE_ACCOUNT_JSON=/absolute/path/to/secrets/google_ads_service_account.json
# Optional Workspace domain-wide delegation:
# GOOGLE_ADS_IMPERSONATED_EMAIL=ads-api@your-domain.com

# --- Measurement (optional) ---
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=ads_agentic_control_plane
CRM_SOURCE=manual

# --- Governance / kill switch ---
# READ_ONLY blocks all writes (default, safest).
# CONTROLLED_LIVE allows capped auto-apply.
# AUTONOMOUS_LIVE allows broader automation with Guardian on.
ADS_AUTOMATION_MODE=READ_ONLY
ADS_MAX_BUDGET_CHANGE_PERCENT=10
ADS_REQUIRE_APPROVAL_ABOVE_PERCENT=15
ADS_BUDGET_COOLDOWN_DAYS=3
# Ad Grants default ≈ $329/day ($10,000 / 30.4). Set your own cap.
ADS_MAX_ACCOUNT_DAILY_BUDGET=329
ADS_ASSET_PUBLISH=approval
ADS_POSITIVE_KEYWORDS=approval
ADS_CPQA_ROLLBACK_WORSEN_PERCENT=25
ADS_CONVERSION_DELAY_DAYS=3
REQUIRE_HUMAN_APPROVAL=true
MAX_DAILY_BUDGET_EUR_WITHOUT_REVIEW=0
POLICY_STRICT_MODE=true

# --- Alerts (optional) ---
ALERT_EMAIL=
SLACK_WEBHOOK_URL=
